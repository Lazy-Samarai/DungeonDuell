  m_TableData:
  - m_Id: 13466628096
    m_Localized: Gegner Raum
    m_Metadata:
      m_Items: []
  - m_Id: 59901767680
    m_Localized: Schatz Raum
    m_Metadata:
      m_Items: []
  - m_Id: 6078770936606720
    m_Localized: Spieler {p}
    m_Metadata:
      m_Items:
      - rid: 6286853880586698886
  - m_Id: 12316632526925824
    m_Localized: "Diese Maske erh\xF6ht deine Geschwindigkeit."
    m_Metadata:
      m_Items: []
  - m_Id: 12316657642418176
    m_Localized: "Diese Maske erh\xF6ht deine Angriffsgeschwindigkeit."
    m_Metadata:
      m_Items: []
  - m_Id: 12317282551771136
    m_Localized: "Beim Betreten eines Gegnerraums wird die T\xFCr verriegelt. \nDein
      Gegenspieler kann die T\xFCr von au\xDFen zerst\xF6ren, um dich zu \xFCberraschen."
    m_Metadata:
      m_Items: []
  - m_Id: 12318426120368128
    m_Localized: "Du verdienst M\xFCnzen, indem du neue R\xE4ume erkundest oder Schatzr\xE4ume
      pl\xFCnderst.\nM\xFCnzen helfen dir, im Laufe des Spiels aufzuleveln."
    m_Metadata:
      m_Items: []
  - m_Id: 12651086692790272
    m_Localized: "Der Dungeon ist voller Monster, die versuchen, dich zu t\xF6ten.
      \nWenn du sie besiegtst wirst du mit M\xFCnzen belohnt."
    m_Metadata:
      m_Items: []
  - m_Id: 12660479467499520
    m_Localized: Stell dich in den Kreis um das Spiel zu starten.
    m_Metadata:
      m_Items: []
  - m_Id: 13316360653008896
    m_Localized: Druecken beliebige Taste
    m_Metadata:
      m_Items: []
  - m_Id: 20233589114040320
    m_Localized: "Schatzr\xE4ume beinhaltet diverse Belohnungen wie Masken oder M\xFCnzen."
    m_Metadata:
      m_Items: []
