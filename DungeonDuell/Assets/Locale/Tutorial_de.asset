  m_SharedData: {fileID: 11400000, guid: 148f4c4cee873794c99bf76a80571304, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 24032079872
    m_Localized: Karten Phase
    m_Metadata:
      m_Items: []
  - m_Id: 178848034816
    m_Localized: Dungeon Phase
    m_Metadata:
      m_Items: []
  - m_Id: 361283481600
    m_Localized: Steuerung
    m_Metadata:
      m_Items: []
  - m_Id: 39357430657024
    m_Localized: "Tastatur Erkl\xE4rung"
    m_Metadata:
      m_Items: []
  - m_Id: 39438632382464
    m_Localized: "Kontroller Erkl\xE4rung"
    m_Metadata:
      m_Items: []
  - m_Id: 39132590796800
    m_Localized: "Dungeon Duell besteht aus zwei Phasen: \nZuerst wird ein Dungeon
      gebaut, danach k\xE4mpft ihr euch hindurch.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 39206129528832
    m_Localized: "W\xE4hrend der Kartenphase legt ihr abwechselnd Dungeon-Karten,\ndie
      neue R\xE4ume mit <color=#CC3F64>Gegnern,</color> <color=#DBB33B>Beute</color>
      und anderen Effekten hinzuf\xFCgen.\r\nDabei k\xF6nnen Wege ge\xF6ffnet oder
      Rivalen gezielt sabotiert werden, \nallerdings nur angrenzend an bestehende
      Kacheln.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 39243207176192
    m_Localized: "Nachdem alle Karten gelegt wurden beginnt die Dungeonphase:\nW\xE4hrend
      du durch den Dungeon ziehst, sammelst du M\xFCnzen, besiegst Gegner \nund suchst
      nach wertvollen Upgrades.\nMit gen\xFCgend M\xFCnzen kannst du die Werte deines
      Charakter verst\xE4rken."
    m_Metadata:
      m_Items: []
  - m_Id: 39289113833472
    m_Localized: "Je gr\xF6\xDFer der gebaute Dungeon ist, desto mehr Zeit habt ihr
      zum Erkunden. \nNutzt jede Sekunde gut, denn was ihr sammelt, nehmt ihr mit
      in die n\xE4chste Runde!\nSobald der Timer abl\xE4uft, geht es zur\xFCck in
      die Kartenphase.\n\nAm Ende trefft ihr im Duell aufeinander. \nDenkt daran:
      Alles was ihr zuvor gesammelt habt, erh\xF6ht eure Chancen auf den Sieg!"
    m_Metadata:
      m_Items: []
  - m_Id: 5105994273943552
    m_Localized: "Ihr k\xF6nnt das Tutorial jederzeit im Pause Men\xFC \xF6ffnen.\nHalte
      LR oder R gedr\xFCckt um weiterzumachen."
    m_Metadata:
      m_Items: []
  - m_Id: 7630781244272640
    m_Localized: "Viel Spa\xDF"
    m_Metadata:
      m_Items: []
  - m_Id: 7640591859740672
    m_Localized: "Linker Stick f\xFCr bewegung"
    m_Metadata:
      m_Items: []
  - m_Id: 7640738702323712
    m_Localized: "WASD f\xFCr bewegung"
    m_Metadata:
      m_Items: []
  - m_Id: 7926432364523520
    m_Localized: Willkommen zu
    m_Metadata:
      m_Items: []
  - m_Id: 8738618322219008
    m_Localized: "In Dungeon Duell teilst du dir einen Lebensbalken \xFCber beide
      Phasen.\nIn der Kartenphase besitzt du deine volle Lebensleiste.\nSie zeigt
      deinen Gesamtzustand und wie viel du mit in die Dungeonphase nehmen kannst."
    m_Metadata:
      m_Items: []
  - m_Id: 20686290497875968
    m_Localized: 'Zu Beginn der Dungeonphase nimmst du bis zu 100 Lebenspunkte mit.

      Verlierst
      du dort Punkte, gehen sie auch in der Kartenphase verloren.


      Im finalen
      Duell nutzt du alle verbleibenden Lebenspunkte direkt im Dungeon.

      Je
      besser du durchkommst, desto mehr Lebenspunkte hast du im entscheidenden Duell.'
    m_Metadata:
      m_Items: []
  - m_Id: 21360561588301824
    m_Localized: Lebensbalken
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
